# docker compose variables. Copy to .env and change as needed (never commit .env).
# Every value has a default in docker-compose.yml, so `docker compose up --build` also works without a .env.

# Postgres (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fnb

# Host port for the db container (container listens on 5432). Change if 5433 is taken locally.
DB_HOST_PORT=5433

# API: allowed browser origin(s), comma-separated
CORS_ORIGIN=http://localhost:8080

# Web: API base URL baked into the frontend build (as seen from the browser)
VITE_API_URL=http://localhost:3000
